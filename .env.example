# 大模型翻译 API Key：用于符合中文语境的本地化翻译与润色
# 任意 OpenAI 兼容接口均可，默认走 DeepSeek
TRANSLATION_API_KEY=

# 默认使用 deepseek-chat；也可换成 deepseek-reasoner、qwen-plus 等
TRANSLATION_MODEL=deepseek-chat

# 默认 DeepSeek 官方接口。使用其他服务商时改成对应的 OpenAI 兼容端点：
# TRANSLATION_API_URL=https://api.deepseek.com/chat/completions
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Moonshot Kimi：https://api.moonshot.cn/v1/chat/completions

# 兼容旧变量名：DASHSCOPE_API_KEY / DASHSCOPE_TRANSLATION_MODEL / DASHSCOPE_API_URL 仍然有效
