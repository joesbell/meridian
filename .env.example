# 大模型翻译 API Key：阿里云百炼（DashScope）密钥，用于 Qwen-MT 专用翻译模型
TRANSLATION_API_KEY=

# 翻译固定使用 Qwen-MT 专用模型（默认 qwen-mt-flash，也可换 qwen-mt-plus / qwen-mt-turbo）
# 注意：该路径走 translation_options 专用协议，不能填通用对话模型
TRANSLATION_MODEL=qwen-mt-flash

# DashScope OpenAI 兼容端点
# TRANSLATION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 未配置 Key 或 Qwen-MT 不可用时，自动降级到 Google Translate
# 兼容旧变量名：DASHSCOPE_API_KEY / DASHSCOPE_TRANSLATION_MODEL / DASHSCOPE_API_URL 仍然有效

# 详情中文摘要：智谱 GLM-4-Flash（永久免费），在 https://open.bigmodel.cn 注册获取 API Key
# 用于文章详情 / GitHub README 的"理解后中文要点总结"（不走逐段翻译）
SUMMARY_API_KEY=
SUMMARY_MODEL=glm-4-flash
SUMMARY_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 未配置 Key 时自动回退到 Qwen-MT 全量翻译

# Cloudflare Turnstile（公网部署时保护 /api/refresh，防止脚本滥用触发付费抓取）
# 在 https://dash.cloudflare.com/turnstile 免费创建站点获取两个 key
# 服务端密钥（校验用，不要暴露）：
TURNSTILE_SECRET_KEY=
# 站点密钥（前端 widget 用，会打进 JS bundle，本身就是公开的）：
VITE_TURNSTILE_SITE_KEY=
# 两个都不配置时（本地开发）验证层自动放行
